# Postgres, required for Prisma / the whole app.
DATABASE_URL=

# NextAuth session secrets — required for login and every protected API route.
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# AI providers — DeepSeek is preferred when set; OPENROUTER_API_KEY is the
# free-model fallback used when it isn't.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Percent markup added on top of DeepSeek's raw token cost when charging the
# wallet for an AI call (src/shared/lib/wallet/pricing.ts). Empty/unset = 0%
# (cost price only, no markup) — this is not an error.
AI_MARKUP_PERCENT=

# S3-compatible storage (Selectel) — required for uploads (chat attachments,
# etc.) via POST /api/upload. NEXT_PUBLIC_S3_PUBLIC_URL is a separate
# "website" domain on the bucket, not the API endpoint.
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
NEXT_PUBLIC_S3_PUBLIC_URL=
